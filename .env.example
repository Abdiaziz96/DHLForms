# Directory holding the live workbook. Defaults to ./data
# On read-only hosts (e.g. Vercel) set this to /tmp so the demo can still write.
DATA_DIR=./data

# Filename of the single workbook. Rows are appended; the file is never regenerated.
WORKBOOK=site-records.xlsx

# Shared secret for the admin routes. Generate one with: openssl rand -hex 32
ADMIN_PASSWORD=change-me

# Secret used to sign driver session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-too

# Site identity shown in the UI. Keeps white-labelling in one place.
NEXT_PUBLIC_SITE_NAME=Severn Beach
NEXT_PUBLIC_APP_NAME=Gatehouse
